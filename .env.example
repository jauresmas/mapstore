# Modèle du fichier .env (lu par docker compose et par les scripts Python).
# « python configurer.py » le copie en .env et remplit les mots de passe vides par des valeurs aléatoires.
# Ne jamais versionner .env.

# Compte "admin" de MapStore, utilisé à sa création (1er démarrage) et par les scripts de publication.
# Si tu le changes dans MapStore (menu utilisateur), reporte-le ici pour que les scripts puissent publier.
MAPSTORE_ADMIN_PASSWORD=

# Rôle PostgreSQL "mapstore" (base interne de MapStore : cartes, contextes, utilisateurs)
MAPSTORE_DB_PASSWORD=

# Compte "admin" du GeoServer de la pile (conteneur mapstore-geoserver)
GEOSERVER_ADMIN_PASSWORD=

# Rôle PostgreSQL "what_ais" (base what_ais_carto), lu par GeoServer et par les scripts du projet
WHAT_AIS_DB_PASSWORD=

# Clone local du dépôt https://github.com/jauresmas/what-ais-doesnt-show (lu seulement).
# Barres obliques « / » même sous Windows. Par défaut : dossier what-ais-doesnt-show à côté de cette pile.
# WHAT_AIS_DEPOT=D:/chemin/vers/what-ais-doesnt-show

# Adresse de la pile vue par les scripts (à changer avec le port de docker-compose.yml et les URL de
# datadir/configs/localConfig.json.patch)
# PILE_URL=http://localhost:8097

# Facultatif, détectés sinon : dossier QGIS (pour son ogr2ogr) et psql.
# QGIS_DIR=C:/Program Files/QGIS 3.34.12
# PSQL=C:/Program Files/PostgreSQL/15/bin/psql.exe
